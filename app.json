{
  "expo": {
    "name": "WalkChamp",
    "slug": "walkchamp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/WalkChampProgress100.png",
    "scheme": [
      "walkchamp",
      "globalwalkerleague"
    ],
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#EAF6E8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.walkchamp.app",
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "We count your steps only to rank you in walking challenges and leaderboards.",
        "NSHealthShareUsageDescription": "We count your steps only to rank you in walking challenges and leaderboards.",
        "NSLocationWhenInUseUsageDescription": "Location is used for GPS-verified walking mode and city leaderboards.",
        "NSCameraUsageDescription": "WalkChamp needs camera access to take a profile photo.",
        "NSPhotoLibraryUsageDescription": "WalkChamp needs access to your photos to upload a profile picture.",
        "NSPhotoLibraryAddUsageDescription": "WalkChamp saves photos to your library.",
        "NSMicrophoneUsageDescription": "Microphone permission is required to use Mic Pass voice chat during live races.",
        "NSAppleIDUsageDescription": "WalkChamp uses Apple Sign-In to create and access your account securely.",
        "CFBundleDisplayName": "WalkChamp"
      },
      "buildNumber": "1"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BODY_SENSORS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.health.READ_STEPS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_HEALTH",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "package": "com.walkchamp.app",
      "versionCode": 1,
      "navigationBar": {
        "backgroundColor": "#0A0B14",
        "barStyle": "light-content"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive/WalkChampProgress100.png",
        "backgroundColor": "#0A0B14"
      }
    },
    "web": {
      "favicon": "./assets/icons/WalkChampProgress100.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAF6E8",
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#EAF6E8",
            "resizeMode": "contain"
          },
          "ios": {
            "backgroundColor": "#EAF6E8",
            "resizeMode": "contain"
          }
        }
      ],
      "expo-dev-client",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "iosNSEFilePath": "./native/onesignal/NotificationService.swift",
          "smallIcons": [
            "./assets/notifications/ic_stat_onesignal_default.png"
          ],
          "largeIcons": [
            "./assets/icons/WalkChampProgress100.png"
          ],
          "smallIconAccentColor": "#00B4FF"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 34,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keepattributes SourceFile,LineNumberTable,*Annotation*\n-keep class com.globalwalkerleague.walkchampraceprogress.** { *; }\n-keep class com.walkchamp.app.WalkChampNotificationServiceExtension { *; }\n-keep class expo.modules.** { *; }\n-keep class expo.modules.ExpoModulesPackageList { *; }\n-keep class com.facebook.react.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.worklets.** { *; }\n-keep class com.onesignal.** { *; }\n-keep class io.livekit.** { *; }\n-keep class androidx.health.connect.** { *; }\n-keep class com.android.billingclient.** { *; }\n-keep class com.google.android.gms.ads.** { *; }\n-keep @expo.modules.core.interfaces.DoNotStrip class *\n-dontwarn com.facebook.react.**\n-dontwarn com.swmansion.reanimated.**"
          }
        }
      ],
      "./plugins/withR8ReleaseOptimization.js",
      "./plugins/withHealthConnectManifest.js",
      "./plugins/withHealthConnectPermissionDelegate.js",
      "./plugins/withAndroidPackageVisibility.js",
      [
        "react-native-health-connect",
        {
          "showHealthConnectPermissionRationale": true
        }
      ],
      "./plugins/withIapStoreFlavor.js",
      "./plugins/withCodegenCMakeFix.js",
      "./plugins/withReactNativeIapKotlinFix.js",
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "WalkChamp needs access to your photos to upload a profile picture.",
          "cameraPermission": "WalkChamp needs camera access to take a profile photo."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "WalkChamp needs your physical activity permission to count steps and compete in challenges."
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "WalkChampProgress0",
            "ios": "./assets/icons/WalkChampProgress0.png",
            "android": {
              "foregroundImage": "./assets/icons/adaptive/WalkChampProgress0.png",
              "backgroundColor": "#0A0B14"
            }
          },
          {
            "name": "WalkChampProgress25",
            "ios": "./assets/icons/WalkChampProgress25.png",
            "android": {
              "foregroundImage": "./assets/icons/adaptive/WalkChampProgress25.png",
              "backgroundColor": "#0A0B14"
            }
          },
          {
            "name": "WalkChampProgress50",
            "ios": "./assets/icons/WalkChampProgress50.png",
            "android": {
              "foregroundImage": "./assets/icons/adaptive/WalkChampProgress50.png",
              "backgroundColor": "#0A0B14"
            }
          },
          {
            "name": "WalkChampProgress75",
            "ios": "./assets/icons/WalkChampProgress75.png",
            "android": {
              "foregroundImage": "./assets/icons/adaptive/WalkChampProgress75.png",
              "backgroundColor": "#0A0B14"
            }
          },
          {
            "name": "WalkChampProgress100",
            "ios": "./assets/icons/WalkChampProgress100.png",
            "android": {
              "foregroundImage": "./assets/icons/adaptive/WalkChampProgress100.png",
              "backgroundColor": "#0A0B14"
            }
          }
        ]
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "react-native-iap",
      "./plugins/withSplitSchemeIntentFilters.js",
      "./plugins/withWalkChampProgressIcons.js",
      "./plugins/withWalkChampRaceProgress.js",
      "./plugins/withWalkChampForegroundService.js",
      "./plugins/withPaymentAppLinks.js",
      "./plugins/withWalkChampLauncherAliases.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.walkchamp.app.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.walkchamp.app.onesignal"
                    ]
                  }
                },
                {
                  "targetName": "WalkChampWidget",
                  "bundleIdentifier": "com.walkchamp.app.WalkChampWidget",
                  "entitlements": {}
                }
              ]
            }
          }
        },
        "projectId": "c83bf004-14fe-4582-b7e1-78617d1d5c96"
      },
      "appEnv": "development",
      "descopeProjectId": "P3E9mQAxf0N6l75csydDy6kGeOPR",
      "enableUnlimitedGoal": true,
      "router": {
        "origin": false
      }
    },
    "owner": "trivia1"
  }
}
