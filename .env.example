# WalkChamp frontend — production env template
# Copy to .env for local production-shaped runs.
# EAS production: set via eas.json + EAS Secrets (never commit live secrets).

# ── App ───────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_URL=https://api.walkchamp.miragaming.com
EXPO_PUBLIC_WEB_URL=https://walkchamp.app
EXPO_PUBLIC_APP_INVITE_URL=https://walkchamp.app/invite

# ── Auth / realtime / push (public client IDs) ─────────────────────────────────
EXPO_PUBLIC_DESCOPE_PROJECT_ID=
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=mt1
# Must match Backend ONESIGNAL_APP_ID. After package rename, OneSignal dashboard
# Android package + iOS bundle must be com.walkchamp.app (not the old id).
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# ── Feature flags (production defaults) ───────────────────────────────────────
EXPO_PUBLIC_ENABLE_CASH_CHALLENGES=false
# Cash UI allowlist when cash is enabled (ISO country codes). Default US,IN.
EXPO_PUBLIC_CASH_ALLOWED_COUNTRIES=US,IN
EXPO_PUBLIC_ENABLE_UNLIMITED_GOAL=true
EXPO_PUBLIC_PAYMENTS_LIVE_MODE=false
EXPO_PUBLIC_ADS_ENABLED=true

# ── Payments (publishable keys only — pk_live_ / rzp_live_ in production) ──────
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# ── AdMob (production IDs for com.walkchamp.app — no Google sample IDs) ────────
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_ID=
EXPO_PUBLIC_ADMOB_IOS_REWARDED_ID=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=

# ── Observability ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=
